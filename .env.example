# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
#
# Каталог, где hh-applicant-tool держит токен и настройки профиля.
# Если не задан, используется .hh-config рядом с проектом.
HH_CONFIG_DIR=

# Необязательно: прокси для запросов к hh (например socks5://127.0.0.1:1080)
HTTPS_PROXY=
